        {
          "type": "function",
          "name": "edit-file",
          "parameters": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "Exact file path inside the workroot, frozen before generating old/new."
              },
              "old_text": {
                "type": "string",
                "description": "Exact unique literal from a physical line start, @ex_meckh_line[N] for insertion, or @ex_meckh_all for the entire file. Include indentation. Markers have no surrounding spaces or newlines."
              },
              "new_text": {
                "type": "string",
                "description": "Exact replacement content, including any intended newline characters. To delete the file after old_text=@ex_meckh_all, use exactly @ex_meckh_delete as the entire argument. Do not add native framing newlines around a marker. Empty content keeps the file; it does not delete it."
              }
            },
            "additionalProperties": false,
            "required": [
              "path",
              "old_text",
              "new_text"
            ]
          },
          "strict": true,
          "description": "Edit a text file inside the workroot synchronously. Supply path, old_text and new_text as exact strings. Existing files require a successful inspect-file followed by read-file of the unchanged content, both fully visible. Literal old_text must start at a physical line boundary including indentation and occur exactly once globally; new_text replaces that occurrence, and may be longer or empty. Use @ex_meckh_line[N] as the entire old_text to insert before physical line N (1..L+1, L+1 appends); include your own newlines. Use @ex_meckh_all to rewrite the whole file. To DELETE an existing file, use old_text=\"@ex_meckh_all\" and new_text=\"@ex_meckh_delete\". Each marker must occupy the entire value, with no leading or trailing space or newline, including native parameter framing newlines. Empty new_text removes content but keeps the file. To create a missing file use @ex_meckh_all or @ex_meckh_line[1], including empty new_text, without inspect/read; its parent must already exist. The @ex_meckh_ family is reserved even inside ordinary text. No implicit escaping, normalization or truncation. The server pauses after path for authorization; missing/stale inspection triggers automatic inspection, while a missing read requires a new explicit read. Changed files and invalid paths/markers/selections are rejected without writes."
        }
      ],
